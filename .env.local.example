# ─── Sanity CMS ─────────────────────────────────────────────
# 1. Create a free account at https://sanity.io
# 2. Run: npx sanity@latest init  (choose "No" to existing dataset)
# 3. Copy the project ID from https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# API token (read-only) — create at sanity.io/manage → API → Tokens
SANITY_API_READ_TOKEN=

# Secret for on-demand revalidation webhook (any random string)
SANITY_REVALIDATE_SECRET=

# ─── Contact Form (optional) ─────────────────────────────────
# Sign up at formspree.io, create a form, and paste your endpoint
NEXT_PUBLIC_FORMSPREE_ID=
